{
  "name": "@snowbitx/ui",
  "version": "0.0.0",
  "type": "module",
  "description": "基于 ant-design-vue 的二次封装组件库",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./components/ProTable": "./src/components/ProTable/index.vue",
    "./components/ProFormBuilder": "./src/components/ProFormBuilder/index.vue",
    "./utils/openDialog": "./src/utils/openDialog.ts",
    "./utils/createApis": "./src/utils/createApis.ts",
    "./components/ProButton": "./src/components/ProButton/index.vue",
    "./components/ProInput": "./src/components/ProInput/index.vue",
    "./components/ProSelect": "./src/components/ProSelect/index.vue",
    "./components/ProCheckboxGroup": "./src/components/ProCheckboxGroup/index.vue",
    "./components/ProRadioGroup": "./src/components/ProRadioGroup/index.vue",
    "./components/ProModal": "./src/components/ProModal/index.vue",
    "./components/ProConfirmButton": "./src/components/ProConfirmButton/index.vue",
    "./components/ProDescriptions": "./src/components/ProDescriptions/index.vue"
  },
  "scripts": {
    "format": "prettier --write src/",
    "type-check": "vue-tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "ant-design-vue": "^4.2.6",
    "vue": "^3.5.17"
  },
  "dependencies": {
    "lodash-es": "^4.17.21"
  },
  "devDependencies": {
    "@vue/tsconfig": "^0.7.0",
    "vue-tsc": "^2.2.10"
  }
}
